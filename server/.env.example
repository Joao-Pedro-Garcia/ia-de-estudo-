# Copie para server/.env e preencha. NUNCA versione o arquivo .env.

# --- IA (obrigatório para a professora, aulas, correção de redação e geração de questões) ---
# Crie a chave em https://console.anthropic.com/ (API Keys).
ANTHROPIC_API_KEY=
# Modelo principal (padrão: claude-opus-5-5).
AI_MODEL=claude-opus-5-5
# Esforço de raciocínio: low | medium | high | xhigh | max (padrão: medium)
AI_EFFORT=medium
# Busca web restrita a domínios oficiais (gov.br, uft.edu.br, ufnt.edu.br, ufma.br, ifma.edu.br). true/false
AI_WEB_SEARCH=true
# Fallback no servidor quando um classificador de segurança recusa (útil em Biologia/Medicina). true/false
AI_SERVER_FALLBACK=true

# --- Servidor ---
PORT=3001
# DB_PATH=./data/aprova.db
# Em produção com HTTPS:
# NODE_ENV=production
# COOKIE_SECURE=true
# Depois de criar a conta da estudante, você pode fechar novos cadastros:
# ALLOW_REGISTRATION=false
